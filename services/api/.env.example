# Copy to services/api/.env and fill in your own key. Never commit .env.
# Local starting-preset provider. Generation stays disabled with these zero defaults.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Candidate from the public catalog; verify availability for your account.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Full-rig provider; Super requires separate operator approval and has a six-request durable cap.
NEBIUS_RIG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional approved one-call Super repair of invalid Nano output; both attempts count.
NEBIUS_RIG_FALLBACK=0
# Set only with operator authorization. 'unlimited' explicitly removes the dollar cap.
# Rig generation requires a bounded numeric budget (US$0–10), never 'unlimited'.
# The 0–100 cumulative request stop and durable usage ledger apply to both paths.
NEBIUS_BUDGET_USD=0
NEBIUS_MAX_REQUESTS=0
