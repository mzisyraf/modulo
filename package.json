{
  "name": "modulo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/audio",
    "contracts"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @modulo/web",
    "build": "npm run build --workspace @modulo/web",
    "typecheck": "tsc --noEmit",
    "test": "node --test contracts/test/*.test.ts packages/audio/test/*.test.ts apps/web/test/*.test.ts",
    "check": "node tools/evaluation/export-rig-catalog.ts --check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
